// Vivi API — consolidated schema (v2, 11 models).
// Source of truth for the decisions: docs/api-contract-v2.md (section 2 lists every
// deviation from the schema approved in the design session, with its reason).
//
// JSONB columns are typed and validated in src/common/types/*:
//   User.settings              -> user-settings.ts
//   WorkoutSheet.structure     -> workout-structure.ts
//   StudentSession.executionData -> execution-data.ts
//   Assessment.data            -> assessment-data.ts
//   Plan.features (String[])   -> plan-features.ts
//
// Constraints Prisma cannot express live in the baseline migration SQL
// (prisma/migrations/20261003000000_baseline_v2/migration.sql, bottom section).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum AccountStatus {
  ACTIVE
  BLOCKED
  OVERDUE
}

enum ClientStatus {
  ACTIVE
  PAUSED
  OVERDUE
  LEAD
}

enum ClientModality {
  PRESENCIAL
  ONLINE
  HYBRID
}

enum WhatsappStatus {
  CONNECTED
  DISCONNECTED
  PENDING
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

enum PaymentProvider {
  MANUAL
  STRIPE
  ASAAS
  MERCADOPAGO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EventType {
  SESSION
  BLOCK
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AssessmentType {
  ANAMNESIS
  PHYSICAL_EVALUATION
}

// --- Models ---

/// The trainer. Owns the business account: login, profile, public slug, branding,
/// WhatsApp connection and settings (Tenant and UserSetting were merged in here).
/// Owner module: identity.
model User {
  id                   String         @id @default(uuid())
  name                 String
  email                String         @unique
  password             String
  role                 String         @default("trainer") // 'admin' | 'trainer'
  /// Account standing, formerly Tenant.status. BLOCKED/OVERDUE lock the student portal.
  status               AccountStatus  @default(ACTIVE)
  avatar               String?
  phone                String?
  bio                  String?
  /// Public address of the trainer, e.g. "gabriel-personal" -> /api/public/gabriel-personal/...
  slug                 String         @unique
  primaryColor         String?        @default("#10B981")
  logoUrl              String?
  whatsappInstanceName String?        @unique
  whatsappStatus       WhatsappStatus @default(PENDING)
  setupCompleted       Boolean        @default(false)
  /// UserSettings document (src/common/types/user-settings.ts)
  settings             Json?          @default("{}")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  clients             Client[]
  plans               Plan[]
  payments            Payment[]
  workoutSheets       WorkoutSheet[]
  exercises           Exercise[]
  events              Event[]
  assessments         Assessment[]
  notificationLogs    NotificationLog[]
  passwordResetTokens PasswordResetToken[]
}

/// Owner module: identity.
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

/// Student or lead. Never hard-deleted by the API: `deletedAt` hides it.
/// Owner module: crm.
model Client {
  id                  String         @id @default(uuid())
  name                String
  email               String
  phone               String
  status              ClientStatus   @default(ACTIVE)
  modality            ClientModality @default(PRESENCIAL)
  goal                String?
  avatar              String?
  notes               String?
  dateOfBirth         DateTime?
  checkInFreq         String?
  medicalHistory      Json?
  notificationEnabled Boolean        @default(true)
  /// Soft delete marker. null = visible.
  deletedAt           DateTime?

  // Subscription and billing
  planId             String?
  plan               Plan?               @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionStatus SubscriptionStatus?
  currentPeriodEnd   DateTime?
  gatewayCustomerId  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments         Payment[]
  events           Event[]
  assessments      Assessment[]
  workoutSheets    WorkoutSheet[]
  studentSessions  StudentSession[]
  notificationLogs NotificationLog[]

  /// E-mails are unique per trainer. Covers soft-deleted rows on purpose (lead resurrection).
  @@unique([email, userId])
  @@index([userId])
  @@index([status])
  @@index([planId])
}

/// Owner module: crm.
model Plan {
  id              String   @id @default(uuid())
  type            String // 'PRESENCIAL' | 'CONSULTORIA'
  name            String
  sessionsPerWeek Int
  durationMinutes Int?
  price           Float
  active          Boolean  @default(true)
  /// PlanFeatureKey values (src/common/types/plan-features.ts)
  features        String[] @default([])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]

  @@index([userId])
}

/// Owner module: crm.
model Payment {
  id         String          @id @default(uuid())
  provider   PaymentProvider @default(MANUAL)
  status     PaymentStatus   @default(PENDING)
  amount     Float
  externalId String?
  date       DateTime        @default(now())
  /// How a MANUAL payment was received: 'PIX' | 'CASH' | 'CARD' (was ManualPayment.paymentType).
  method     String?
  /// Subscription period this payment covers up to (was ManualPayment.validUntil).
  periodEnd  DateTime?
  notes      String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
}

/// A client's sheet (clientId set) or a reusable template (isTemplate, clientId null).
/// Owner module: workouts.
model WorkoutSheet {
  id         String    @id @default(uuid())
  name       String
  expiresAt  DateTime?
  active     Boolean   @default(true)
  isTemplate Boolean   @default(false)
  /// WorkoutSheetStructure document (src/common/types/workout-structure.ts)
  structure  Json

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([clientId])
  @@index([userId])
}

/// Hybrid catalogue: userId null = global (Vivi), otherwise private to the trainer.
/// Owner module: workouts.
model Exercise {
  id           String  @id @default(uuid())
  name         String
  bodyPart     String
  targetMuscle String?
  equipment    String
  gifUrl       String?
  videoUrl     String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([bodyPart])
}

/// A workout the student finished in the portal.
/// Owner module: workouts.
model StudentSession {
  id              String   @id @default(uuid())
  workoutName     String?
  durationSeconds Int
  completedAt     DateTime @default(now())
  /// ExecutionData document (src/common/types/execution-data.ts)
  executionData   Json

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([completedAt])
}

/// Unified calendar row.
///   one-off session : type SESSION, rrule null, parentEventId null
///   series master   : type SESSION, rrule set,  parentEventId null
///   exception       : type SESSION, rrule null, parentEventId + originalStartTime set
///                     (status CANCELLED = occurrence removed, COMPLETED = occurrence done,
///                      SCHEDULED = occurrence edited/moved)
///   block           : type BLOCK, clientId null, rrule optional; ends at date + durationMinutes
/// Owner module: calendar.
model Event {
  id              String      @id @default(uuid())
  type            EventType
  title           String?
  date            DateTime
  durationMinutes Int
  status          EventStatus @default(SCHEDULED)
  rrule           String?
  timezone        String      @default("America/Sao_Paulo")
  notes           String?
  /// SESSION only: 'In-Person' | 'Online' (was Session.type)
  sessionType     String?
  /// SESSION only: 'Workout' | 'Check-in' | 'Evaluation' (was Session.category)
  category        String?

  /// Exception -> series master. Deleting the master deletes its exceptions.
  parentEventId     String?
  parent            Event?    @relation("EventExceptions", fields: [parentEventId], references: [id], onDelete: Cascade)
  exceptions        Event[]   @relation("EventExceptions")
  /// The RRULE-computed start this exception replaces. Set iff parentEventId is set.
  originalStartTime DateTime?

  workoutSheetId   String?
  workoutSheet     WorkoutSheet? @relation(fields: [workoutSheetId], references: [id], onDelete: SetNull)
  /// WorkoutItem.id inside WorkoutSheet.structure
  workoutSegmentId String?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentEventId, originalStartTime])
  @@index([userId])
  @@index([clientId])
  @@index([userId, date])
  @@index([workoutSheetId])
}

/// Anamnesis (filled by the student through a magic link) or physical evaluation
/// (filled by the trainer). Owner module: health.
model Assessment {
  id             String         @id @default(uuid())
  type           AssessmentType
  /// AnamnesisData | PhysicalEvaluationData (src/common/types/assessment-data.ts)
  data           Json
  /// Evaluation date (PHYSICAL_EVALUATION) or submission time (ANAMNESIS).
  date           DateTime       @default(now())
  magicToken     String?        @unique
  tokenExpiresAt DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([clientId, type, date])
}

/// Audit trail of outbound messages. One row per finished job; nothing is queued here.
/// Owner module: messaging.
model NotificationLog {
  id             String  @id @default(uuid())
  recipientPhone String
  templateType   String
  status         String // 'SENT' | 'FAILED' | 'CANCELLED'
  channel        String  @default("WHATSAPP") // 'WHATSAPP' | 'EMAIL'
  error          String?
  /// BullMQ job id = idempotency key of the notification. One log row per job.
  jobId          String? @unique

  /// Recipient, when the message is addressed to a client (feeds GET /clients/:id/messages).
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
  @@index([status])
}
