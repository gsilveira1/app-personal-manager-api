generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum ClientStatus {
  Active
  Inactive
  Lead
}

enum TenantStatus {
  ACTIVE
  BLOCKED
  OVERDUE
}

enum WhatsappStatus {
  CONNECTED
  DISCONNECTED
  PENDING
}

// --- Models ---

model Tenant {
  id                   String         @id @default(uuid())
  name                 String
  slug                 String         @unique
  status               TenantStatus   @default(ACTIVE)
  primaryColor         String?        @default("#10B981")
  logoUrl              String?
  whatsappInstanceName String?        @unique
  whatsappStatus       WhatsappStatus @default(PENDING)
  setupCompleted       Boolean        @default(false)
  features             Json?          @default("{\"maxStudents\": 50, \"canUploadVideos\": true, \"whatsappAlerts\": true}")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  users            User[]
  clients          Client[]
  exercises        Exercise[]
  notificationLogs NotificationLog[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // 'admin', 'trainer'
  avatar    String?
  phone     String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // Relacionamentos: O usuário é dono de tudo isso
  clients            Client[]
  sessions           Session[]
  recurringEvents    RecurringEvent[]
  plans              Plan[]
  settings           UserSetting[]
  availabilityBlocks AvailabilityBlock[]
  manualPayments     ManualPayment[]
  anamneses          Anamnesis[]
  workoutSheets      WorkoutSheet[]
  workoutTemplates   WorkoutTemplate[]
  exercises          Exercise[]

  @@index([tenantId])
}

model Client {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  phone               String
  status              ClientStatus @default(Active)
  modality            String?      @default("ONLINE") // ONLINE, PRESENCIAL, HYBRID
  subscriptionStatus  String?      @default("ACTIVE") // ACTIVE, OVERDUE, PAUSED
  currentPeriodEnd    DateTime?
  type                String
  goal                String?
  avatar              String?
  notes               String?
  dateOfBirth         DateTime?
  checkInFreq         String?
  medicalHistory      Json?
  notificationEnabled Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamento com Plano
  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  // Multi-tenant: Vinculado ao Tenant e ao Usuário (Treinador)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relacionamento com Usuário (Dono do registro)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Outros relacionamentos
  sessions        Session[]
  recurringEvents RecurringEvent[]
  evaluations     Evaluation[]
  manualPayments  ManualPayment[]
  anamneses       Anamnesis[]
  workoutSheets   WorkoutSheet[]
  studentSessions StudentSession[]

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([planId])
}

model Plan {
  id              String   @id @default(uuid())
  type            String // 'PRESENCIAL' | 'CONSULTORIA'
  name            String // e.g., "Hipertrofia 2x na Semana (60min)"
  sessionsPerWeek Int // 1–6 for PRESENCIAL, 1–2 for CONSULTORIA
  durationMinutes Int? // 30, 45, 60, 90 (null for CONSULTORIA)
  price           Float
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Planos pertencem a um Usuário (Treinador)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  clients  Client[]
  features PlanFeature[]

  @@index([userId])
}

model SystemFeature {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. "ai_whatsapp_bot", "posture_correction"
  name        String // Display name, e.g. "Bot WhatsApp com IA"
  description String?
  isActive    Boolean @default(true) // Admin can deactivate globally

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans PlanFeature[]
}

model PlanFeature {
  planId    String
  plan      Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   SystemFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  assignedAt DateTime @default(now())

  @@id([planId, featureId])
  @@index([featureId])
}

model Session {
  id              String   @id @default(uuid())
  date            DateTime
  durationMinutes Int
  type            String
  category        String
  completed       Boolean  @default(false)
  cancelled       Boolean  @default(false)
  notes           String?
  recurrenceId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamento com Cliente (Quem treinou)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Relacionamento com Usuário (Responsável pela sessão/Treinador)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Relacionamento com Treino (Ficha / Divisão)
  linkedWorkoutId String?
  workout         WorkoutSheetItem? @relation(fields: [linkedWorkoutId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([clientId])
  @@index([linkedWorkoutId])
}

model Evaluation {
  id                String   @id @default(uuid())
  date              DateTime
  weight            Float
  height            Float?
  bodyFatPercentage Float?
  leanMass          Float?
  fatMass           Float?
  bodyDensity       Float?
  protocol          String?
  equation          String?
  notes             String?
  perimeters        Json?
  skinfolds         Json?

  // Avaliações pertencem a um Cliente
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// Configurações específicas por Usuário
model UserSetting {
  key   String
  value String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Chave composta: cada usuário pode ter sua própria chave 'ai_prompt', por exemplo.
  @@id([userId, key])
}

// ---
// RFC 5545-based recurrence (Google Calendar model)
// ---

model RecurringEvent {
  id              String   @id @default(uuid())
  /// Full RRULE string, e.g. "FREQ=WEEKLY;BYDAY=MO,WE;COUNT=12"
  rrule           String
  /// TZID used when expanding the rule, e.g. "America/Sao_Paulo"
  timezone        String   @default("America/Sao_Paulo")
  /// ISO datetime of the first occurrence (DTSTART)
  dtstart         DateTime
  durationMinutes Int
  type            String // "In-Person" | "Online"
  category        String // "Workout" | "Check-in" | "Evaluation"
  notes           String?
  linkedWorkoutId String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  exceptions SessionException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
}

model SessionException {
  id String @id @default(uuid())

  /// The computed start time this exception replaces
  originalStartTime DateTime

  /// true = this occurrence is cancelled (soft-delete)
  cancelled Boolean @default(false)

  /// Overrides (only relevant when cancelled = false)
  newStartTime    DateTime?
  durationMinutes Int?
  notes           String?
  completed       Boolean   @default(false)

  recurringEventId String
  recurringEvent   RecurringEvent @relation(fields: [recurringEventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recurringEventId, originalStartTime])
  @@index([recurringEventId])
}

model AvailabilityBlock {
  id       String   @id @default(uuid())
  title    String // "Almoço", "Férias"
  rrule    String? // null = one-off, else RFC 5545
  timezone String   @default("America/Sao_Paulo")
  dtstart  DateTime
  dtend    DateTime // dtstart+dtend define the block window
  notes    String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, dtstart])
}

model ManualPayment {
  id          String   @id @default(uuid())
  clientId    String
  userId      String
  paymentType String // MANUAL_PIX, MANUAL_CASH, MANUAL_CARD
  validUntil  DateTime
  notes       String?
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
}

model Anamnesis {
  id                 String   @id @default(uuid())
  clientId           String
  userId             String
  isCurrent          Boolean  @default(true)
  token              String?  @unique
  tokenUsed          Boolean  @default(false)
  medicalHistory     String?
  injuriesAndPain    String?
  routineAndSchedule String?
  fitnessGoals       String?
  experienceLevel    String?
  parqAnswers        Json?
  frontPhotoUrl      String?
  backPhotoUrl       String?
  sidePhotoUrl       String?
  weightKg           Float?
  measurements       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
}

model Exercise {
  id           String   @id @default(uuid())
  name         String
  bodyPart     String
  targetMuscle String?
  equipment    String
  gifUrl       String?
  videoUrl     String?
  isCustom     Boolean  @default(false)
  userId       String?
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  workoutExercises WorkoutExercise[]

  @@index([userId])
  @@index([tenantId])
  @@index([bodyPart])
  @@index([equipment])
}

model WorkoutSheet {
  id        String    @id @default(uuid())
  name      String
  expiresAt DateTime?
  active    Boolean   @default(true)
  clientId  String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id])
  workouts WorkoutSheetItem[]

  @@index([clientId])
  @@index([userId])
}

model WorkoutSheetItem {
  id         String   @id @default(uuid())
  sheetId    String
  letter     String
  name       String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  blocks   WorkoutBlock[]
  sheet    WorkoutSheet   @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([sheetId])
}

model WorkoutBlock {
  id              String   @id @default(uuid())
  workoutId       String
  type            String   @default("REGULAR") // REGULAR, BISET, TRISET
  orderIndex      Int      @default(0)
  restTimeSeconds Int      @default(60)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  exercises WorkoutExercise[]
  workout   WorkoutSheetItem  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

model WorkoutExercise {
  id              String   @id @default(uuid())
  blockId         String
  exerciseId      String?
  exerciseName    String
  gifUrl          String?
  sets            Int      @default(3)
  reps            String   @default("10-12")
  suggestedLoadKg Float?
  executionNotes  String?
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  block    WorkoutBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercise Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([blockId])
  @@index([exerciseId])
}

model WorkoutTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  structure   Json
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model StudentSession {
  id              String   @id @default(uuid())
  clientId        String
  workoutId       String?
  workoutName     String?
  durationSeconds Int
  completedAt     DateTime @default(now())
  loads           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([completedAt])
  @@index([workoutId])
}

model NotificationLog {
  id             String   @id @default(uuid())
  tenantId       String?
  recipientPhone String
  templateType   String
  status         String // SENT, QUEUED, FAILED
  channel        String   @default("WHATSAPP") // WHATSAPP, EMAIL
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@index([status])
}
