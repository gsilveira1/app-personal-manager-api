# Local development environment template
# Copy to .env and fill in the values — NEVER commit .env

# Server
PORT=9090
NODE_ENV=development
# Signs access tokens and student-portal links. Generate one: openssl rand -base64 48
# With NODE_ENV=production the app refuses to start when JWT_SECRET is missing, is shorter
# than 32 characters, or is a known placeholder (the value below, seu_segredo_aqui,
# segredo_padrao_dev). Changing it signs everyone out and invalidates issued portal links.
JWT_SECRET=seu_segredo_super_secreto_aqui
# Base URL of the trainer/student web app: magic links and password-reset links are built from it.
# Falls back to APP_CLIENT_URL, then http://localhost:5173 (the old Vite port; the Astro dev server runs on 4321) — set it in production.
FRONTEND_URL=http://localhost:4321
# Extra origins allowed to call the API cross-origin (comma-separated absolute URLs, e.g. the
# public website). The origins of FRONTEND_URL and APP_CLIENT_URL are always allowed, and
# localhost origins are allowed outside production. "*" is rejected at start-up.
# CORS_ALLOWED_ORIGINS=https://www.example.com

# Database scripts (npm run db:seed / db:reset, prisma db seed)
# The seed refuses to run with NODE_ENV=production unless SEED_ALLOW_PRODUCTION=true, and then
# requires SEED_ADMIN_PASSWORD (12+ characters, no default) for the accounts it creates.
# db:reset (TRUNCATE of every table) never runs with NODE_ENV=production.
# Outside production SEED_ADMIN_PASSWORD is optional (default: admin123).
# SEED_ALLOW_PRODUCTION=false
# SEED_ADMIN_PASSWORD=

# PostgreSQL (Docker Compose / Local)
# docker-compose.yml (the production stack) has no defaults for POSTGRES_PASSWORD, JWT_SECRET,
# AUTHENTICATION_API_KEY and EVOLUTION_API_KEY: `docker compose up` fails until they are set.
# The values below are for local development only.
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=gym_management
POSTGRES_PORT=5432
DATABASE_URL="postgresql://admin:password123@localhost:5432/gym_management?schema=public"

# Redis 7 (Cache, Sessions, Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password123
# Required: the notifications queue (BullMQ) connects with this URL only; the app does not start without it.
# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD above are for docker compose, the queue does not read them.
REDIS_URL="redis://localhost:6379"

# Evolution API (WhatsApp Integration - replaces WAHA)
EVOLUTION_PORT=8080
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="personalops_secret_token_123"
# Optional, milliseconds (default 10000)
EVOLUTION_API_TIMEOUT_MS=10000
AUTHENTICATION_API_KEY="personalops_secret_token_123"

# Mailpit (Local SMTP testing)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
# Implicit TLS ("true" | "false"). Default: true in production on port 465, false otherwise
# (STARTTLS is then negotiated when the server offers it).
# EMAIL_SMTP_SECURE=false
# SMTP auth: set both or neither.
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
EMAIL_FROM="viviOps <noreply@viviops.com>"

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=app-personal-manager-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Google Cloud Storage — avatar uploads
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=""
GCS_BUCKET_NAME=gym_management

# Gemini AI Key
GEMINI_API_KEY=
